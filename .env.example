# ---- Required ----
# Postgres connection (owner role). Neon: use the pooled connection string with sslmode=require.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Public URL of the app (used for auth cookies/redirects)
APP_URL=http://localhost:3000
# 32+ random bytes: openssl rand -base64 32
AUTH_SECRET=

# ---- AI (all optional; features stay OFF until enabled) ----
# Any OpenAI-compatible chat-completions endpoint. Examples:
# Set AI_PROVIDER=openai-compatible to turn the AI layer on.
#   Gemini free tier: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL_TEXT=gemini-2.5-flash  AI_FREE_TIER=true
#   OpenAI:           AI_BASE_URL=https://api.openai.com/v1                                 AI_MODEL_TEXT=gpt-4o-mini
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL_TEXT=
AI_PROVIDER_LABEL=
# true = provider bills $0 (free tier); costs are then recorded as $0 but requests are still counted and rate-limited
AI_FREE_TIER=false
AI_TIMEOUT_MS=30000
# Per-feature flags (true/false)
AI_FEATURE_WRITING=false
AI_FEATURE_TUTOR=false
AI_FEATURE_CONTENT_GENERATION=false
# Real-time voice is paid (OpenAI Realtime). Keep false unless explicitly approved.
AI_FEATURE_REALTIME=false
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=

# ---- Push notifications (optional) ----
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for /api/cron/reminders (24+ chars)
CRON_SECRET=

# ---- Optional ----
DATABASE_POOL_MAX=5
