{
  "name": "english-coach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:seed": "tsx scripts/content-seed.ts",
    "owner:create": "tsx --require ./scripts/server-only-shim.cjs scripts/owner.ts create",
    "owner:reset-password": "tsx --require ./scripts/server-only-shim.cjs scripts/owner.ts reset-password",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "e2e:reset": "tsx scripts/e2e-reset.ts",
    "content:generate": "tsx --require ./scripts/server-only-shim.cjs scripts/content-generate.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.26",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ts-fsrs": "^6.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
